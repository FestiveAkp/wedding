---
import Page from '@/layouts/Page.astro'
import PageOpener from '@/components/PageOpener.astro'
import PhoneForm from '@/components/PhoneForm.astro'
import ScheduleEvent from '@/components/ScheduleEvent.astro'
import VerifyForm from '@/components/VerifyForm.astro'
import { sections } from '@/data/sections'
import { eventOrder, invitationEvents } from '@/data/events'
import { guestGate } from '@/lib/verify'

export const prerender = false

const { no, title } = sections[1]

// Which events a household is invited to is private, so the extra events wait for a code
const gate = await guestGate(Astro)
if (gate.redirect) return Astro.redirect(gate.redirect, 303)
const { visitor, verify } = gate
/** Only set once the number is verified */
const { household } = visitor
const extraEvents = eventOrder
	.filter((id) => household?.events.includes(id))
	.map((id) => invitationEvents[id])
---

<Page>
	<article>
		<PageOpener no={no}>
			{title}
		</PageOpener>

		<div class="mx-auto max-w-6xl px-6 md:px-10">
			{
				household && (
					<p class="pt-10 text-ink/70 md:pt-14">
						<span class="font-display text-2xl italic text-deep">Dear {household.greeting},</span>
						<br />
						{extraEvents.length > 0
							? 'We’d love for you to join us for all of these.'
							: 'Here’s the plan for the day.'}
						<a href="?switch" class="ml-1 text-sm text-ink/50 underline underline-offset-2 hover:text-rose">
							Not you?
						</a>
					</p>
				)
			}

			<div class="divide-y divide-ink/15">
				{
					extraEvents.map((event) => (
						<ScheduleEvent event={event}>
							<p>{event.description}</p>
						</ScheduleEvent>
					))
				}

				<ScheduleEvent
					event={{
						title: 'Wedding & lunch',
						place: 'The Leela Kovalam · Kovalam, Thiruvananthapuram',
						date: { weekday: 'Sunday', day: '27', month: 'June 2027' },
					}}
				>
					<p>Our wedding ceremony at The Leela, followed by lunch.</p>

					<aside slot="aside" class="mt-14 bg-paper-dim p-6 md:p-8">
						<h3 class="font-display text-2xl text-deep">
							The thalikettu <span class="italic text-ink/60">&middot; early morning</span>
						</h3>
						<p class="mt-3 leading-relaxed text-ink/80">
							We&rsquo;ll start the day with our thalikettu, a traditional ceremony where
							the thali is tied, at a small temple with close family. The temple can
							only hold a few people, so we&rsquo;ll be in touch directly if you&rsquo;re
							joining us there.
						</p>
					</aside>
				</ScheduleEvent>
			</div>

			{
				!household && (
					<div id="invitations" class="mb-14 bg-paper-dim px-6 py-12 md:mb-20 md:px-12">
						{visitor.phone ? (
							<VerifyForm
								phone={visitor.phone}
								sent={verify?.codeSent ?? false}
								error={verify?.error}
								hash="#invitations"
							/>
						) : (
							<PhoneForm visitor={visitor} label="See your invitations" hash="#invitations" />
						)}
					</div>
				)
			}
		</div>
	</article>
</Page>
