---
import Page from '../layouts/Page.astro'
import PageOpener from '../components/PageOpener.astro'
import { sections } from '../data/sections'

const { no, title } = sections[1]
---

<Page>
	<article>
		<PageOpener no={no}>
			{title}
		</PageOpener>

		<div class="mx-auto grid max-w-6xl grid-cols-1 gap-14 px-6 py-14 md:grid-cols-12 md:gap-10 md:px-10 md:py-20">
			<div class="md:col-span-4">
				<p class="text-xs font-medium uppercase tracking-widest text-ink/50">Sunday</p>
				<p class="font-display text-[9rem] font-light leading-[0.85] text-rose md:text-[11rem]">27</p>
				<p class="mt-2 font-display text-2xl italic text-deep">June 2027</p>
				<div class="mt-6 h-px w-16 bg-brass"></div>
				<p class="mt-4 text-sm text-ink/60">Time to be announced</p>
			</div>

			<div class="md:col-span-8">
				<section>
					<h2 class="font-display text-4xl text-deep md:text-5xl">Wedding &amp; lunch</h2>
					<p class="mt-3 font-display text-xl italic text-ink/70">
						The Leela Kovalam &middot; Kovalam, Thiruvananthapuram
					</p>

					<p class="mt-6 max-w-[55ch] text-lg leading-relaxed text-ink/85">
						Our wedding ceremony at The Leela, followed by lunch.
					</p>
				</section>

				<aside class="mt-14 bg-paper-dim p-6 md:p-8">
					<h3 class="font-display text-2xl text-deep">
						The thalikettu <span class="italic text-ink/60">&middot; early morning</span>
					</h3>
					<p class="mt-3 leading-relaxed text-ink/80">
						We&rsquo;ll start the day with our thalikettu, a traditional ceremony where
						the thali is tied, at a small temple with close family. The temple can
						only hold a few people, so we&rsquo;ll be in touch directly if you&rsquo;re
						joining us there.
					</p>
				</aside>
			</div>
		</div>
	</article>
</Page>
