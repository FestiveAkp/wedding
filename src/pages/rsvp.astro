---
import Page from '@/layouts/Page.astro'
import PageOpener from '@/components/PageOpener.astro'
import PhoneForm from '@/components/PhoneForm.astro'
import RsvpForm from '@/components/RsvpForm.astro'
import RsvpThanks from '@/components/RsvpThanks.astro'
import VerifyForm from '@/components/VerifyForm.astro'
import { sections } from '@/data/sections'
import { latestRsvp, type Rsvp } from '@/lib/guests'
import { draftFrom, handleReply, type ReplyResult } from '@/lib/reply'
import { guestGate } from '@/lib/verify'

export const prerender = false

const { no, title } = sections[4]

// `verify` is set exactly when the code box should be shown
const {redirect, form, visitor, verify} = await guestGate(Astro)
if (redirect) return Astro.redirect(redirect, 303)

const reply: ReplyResult = visitor.verified ? await handleReply(form, visitor.household, visitor.phone, Astro.url) : {}
if (reply.redirect) return Astro.redirect(reply.redirect, 303)

/** The household's most recent reply, used to prefill the form */
let current: Rsvp | undefined
/** Their earlier reply couldn't be loaded, so the form is withheld unless there's a draft to show */
let replyUnavailable = false
if (visitor.verified) {
	try {
		current = await latestRsvp(visitor.household)
	} catch (e) {
		// Never fall back to a blank form, which would invite overwriting their earlier reply
		console.error('Could not load RSVP', e)
		replyUnavailable = true
	}
}

// Thank the guest for the reply they just saved. If reading it back failed, `?saved` still
// says whether they're coming, which is enough for the note.
const savedReply = Astro.url.searchParams.get('saved')
const saved =
	savedReply === 'yes' || savedReply === 'no'
		? { attending: current?.attending ?? savedReply === 'yes', names: current?.names }
		: undefined
/** The same page without `?saved`, which brings the form back */
const changeUrl = new URL(Astro.url)
changeUrl.searchParams.delete('saved')
---

<Page>
	<article>
		<PageOpener no={no}>
			{title}
		</PageOpener>

		<div id="reply" class="mx-auto max-w-6xl px-6 py-10 md:px-10 md:py-20">
			<div class="mx-auto max-w-2xl sm:bg-paper-dim sm:px-6 sm:py-12 md:px-12">
				{
					!visitor.phone ? (
						<PhoneForm visitor={visitor} label="Find your invitation" hash="#reply" />
					) : !visitor.verified ? (
						<VerifyForm phone={visitor.phone} sent={verify?.codeSent ?? false} error={verify?.error} hash="#reply" />
					) : saved ? (
						<RsvpThanks {...saved} changeHref={changeUrl.pathname + changeUrl.search} />
					) : replyUnavailable && !reply.draft ? (
						<p role="alert" class="text-center text-rose">
							Something went wrong loading your invitation. Please try again in a few minutes.
						</p>
					) : (
						<RsvpForm household={visitor.household} draft={reply.draft ?? draftFrom(current)} replied={Boolean(current) || replyUnavailable} error={reply.error} />
					)
				}
			</div>
		</div>
	</article>
</Page>
