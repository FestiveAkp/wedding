---
import Page from '../layouts/Page.astro'
import PageOpener from '../components/PageOpener.astro'
import PhoneForm from '../components/PhoneForm.astro'
import RsvpForm from '../components/RsvpForm.astro'
import RsvpThanks from '../components/RsvpThanks.astro'
import { sections } from '../data/sections'
import { latestRsvp, saveRsvp, type Rsvp } from '../lib/guests'
import { draftFrom, parseReply, type Draft } from '../lib/reply'
import { identifyVisitor } from '../lib/visitor'

export const prerender = false

const { no, title } = sections[4]

const visitor = await identifyVisitor(Astro.url, Astro.cookies)
// Only on GET, so a reply posted from an older tab still with ?p= isn't dropped
if (visitor.redirect && Astro.request.method === 'GET') return Astro.redirect(visitor.redirect)
const { household, phone } = visitor

let error: string | undefined
/** The guest's submission, shown again so an error doesn't wipe what they typed */
let draft: Draft | undefined

if (Astro.request.method === 'POST' && household && phone) {
	const reply = parseReply(await Astro.request.formData(), household)
	error = reply.error
	draft = reply.draft
	if (reply.rsvp) {
		try {
			await saveRsvp(household, phone, reply.rsvp)
			const done = new URL(Astro.url)
			done.searchParams.set('saved', reply.rsvp.attending ? 'yes' : 'no')
			return Astro.redirect(done.pathname + done.search, 303)
		} catch (e) {
			console.error('Could not save RSVP', e)
			error = 'Something went wrong saving your reply. Please try again in a few minutes.'
		}
	}
}

let current: Rsvp | undefined
let replyUnavailable = false
if (household) {
	try {
		current = await latestRsvp(household)
	} catch (e) {
		// Never fall back to a blank form, which would invite overwriting their earlier reply
		console.error('Could not load RSVP', e)
		replyUnavailable = true
	}
}

// Trust the reply we just saved even if reading it back fails
const savedReply = Astro.url.searchParams.get('saved')
const saved =
	savedReply === 'yes' || savedReply === 'no'
		? (current ?? { attending: savedReply === 'yes', names: [], message: '' })
		: undefined
const changeUrl = new URL(Astro.url)
changeUrl.searchParams.delete('saved')
---

<Page>
	<article>
		<PageOpener no={no}>
			{title}
		</PageOpener>

		<div id="reply" class="mx-auto max-w-6xl px-6 py-10 md:px-10 md:py-20">
			<div class="mx-auto max-w-2xl sm:bg-paper-dim sm:px-6 sm:py-12 md:px-12">
				{
					!household ? (
						<PhoneForm visitor={visitor} label="Find your invitation" action="#reply" />
					) : saved ? (
						<RsvpThanks rsvp={saved} changeHref={changeUrl.pathname + changeUrl.search} />
					) : replyUnavailable && !draft ? (
						<p role="alert" class="text-center text-rose">
							Something went wrong loading your invitation. Please try again in a few minutes.
						</p>
					) : (
						<RsvpForm household={household} draft={draft ?? draftFrom(current)} replied={Boolean(current)} error={error} />
					)
				}
			</div>
		</div>
	</article>
</Page>
