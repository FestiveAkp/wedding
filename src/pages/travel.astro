---
import Page from '@/layouts/Page.astro'
import { Image } from 'astro:assets'
import PageOpener from '@/components/PageOpener.astro'
import kovalamPhoto from '@/assets/sahal-fidhu-sajeeb-Z53dNF1BLK4-unsplash.jpg'
import { sections } from '@/data/sections'

const { no, title } = sections[2]

// Placeholder copy; search for TBD to find everything still to be filled in
const TBD = 'Details to follow'

const maps = {
	airport: 'https://www.google.com/maps/search/?api=1&query=Trivandrum+International+Airport',
	hotel: 'https://www.google.com/maps/search/?api=1&query=The+Leela+Kovalam+a+Raviz+Hotel',
}

const links = [
	{ href: maps.airport, label: 'Airport' },
	{ href: maps.hotel, label: 'Hotel' },
]

const routes = [
	{
		title: 'From abroad',
		notes: [
			{
				heading: 'Getting to TRV',
				body: 'There are no direct flights from the US, so expect one or two connections — usually through a Gulf hub like Doha, Dubai or Abu Dhabi, or via Mumbai, Delhi, Bengaluru or Chennai.',
			},
			{
				heading: 'Connecting within India',
				body: 'If your connection is inside India, you’ll clear immigration and customs at your first Indian airport and re-check your bags there. Leave yourself at least three hours.',
			},
			{
				heading: 'Airport pickup',
				// TODO: confirm whether we're running shuttles and on which days
				body: TBD,
			},
			{
				heading: 'When to arrive',
				// TODO: suggested arrival date, e.g. "by Thursday, June 24"
				body: TBD,
			},
		],
	},
	{
		title: 'From within India',
		notes: [
			{
				heading: 'By road',
				body: 'The Leela sits on the coast at Kovalam, about 30 minutes south of Thiruvananthapuram city. From Kochi, plan on five to six hours.',
			},
			{
				heading: 'By train or air',
				body: 'Thiruvananthapuram Central (TVC) is the closest major station, about 40 minutes away by car. Domestic flights land at TRV, 30 minutes from the hotel.',
			},
			{
				heading: 'Parking',
				// TODO: confirm guest parking / valet with the hotel
				body: TBD,
			},
		],
	},
]

// TODO: fill in from the hotel contract
const block = [
	{ label: 'Nights held', value: TBD },
	{ label: 'Group rate', value: TBD },
	{ label: 'How to book', value: TBD },
	{ label: 'Book by', value: TBD },
	{ label: 'Check-in / check-out', value: TBD },
	{ label: 'Included', value: TBD },
]

const checklist = [
	{
		item: 'Passport',
		body: 'Valid for at least six months after you land, with two blank pages.',
	},
	{
		item: 'Visa',
		body: 'US citizens need one. Most people use the e-Visa — apply only through the official government site, and give yourself a few weeks. OCI cardholders don’t need a visa.',
		href: 'https://indianvisaonline.gov.in/evisa/',
		cta: 'Official e-Visa site',
	},
	{
		item: 'Health',
		body: 'Check the CDC’s guidance for India and talk to your doctor a month or two before you go.',
		href: 'https://wwwnc.cdc.gov/travel/destinations/traveler/none/india',
		cta: 'CDC travel page',
	},
	{
		item: 'Money',
		body: 'Cards work at the hotel. Carry some rupees for taxis and small shops — there are ATMs at the airport.',
	},
	{
		item: 'Phone',
		body: 'Set up an international plan or eSIM before you leave. WhatsApp is how everyone here keeps in touch.',
	},
	{
		item: 'Plugs',
		body: 'India uses 230V with Type C, D and M sockets, so pack a travel adapter/voltage converter.',
	},
	{
		item: 'Time',
		body: 'Kerala runs on India Standard Time — 9½ hours ahead of New York and 12½ ahead of California in June.',
	},
]

const weather = [
	{ label: 'Temperature', value: 'Upper 70s to mid 80s °F' },
	{ label: 'Rain', value: 'Heavy, passing showers' },
	{ label: 'Pack', value: 'Light layers, umbrella, sandals' },
]

// TODO: add our own favorites and any group outings we organize
const extras = [
	{
		place: 'Padmanabhaswamy Temple',
		body: 'The city’s great temple, about 30 minutes away. It has a strict dress code, so ask us before you go.',
	},
	{
		place: 'Poovar',
		body: 'Backwaters and a quiet estuary beach, a short drive south of Kovalam.',
	},
	{
		place: 'Varkala',
		body: 'Red cliffs over the sea and a lively strip of cafés, around 90 minutes north.',
	},
	{
		place: 'Further afield',
		body: 'Staying longer? Alleppey’s houseboats and the tea hills of Munnar are worth a few extra days.',
	},
]

// TODO: who guests should reach out to with travel questions
const contact = TBD
---

<Page>
	<article>
		<PageOpener no={no}>
			{title}
		</PageOpener>

		<div class="mx-auto max-w-6xl px-6 py-14 md:px-10 md:py-20">
			<section aria-label="From the airport to the hotel" class="relative overflow-hidden bg-deep text-paper">
				<div
					class="flex flex-col p-8 md:p-12 lg:grid lg:grid-cols-[auto_minmax(10rem,1fr)_auto] lg:grid-rows-[auto_auto_auto] lg:gap-x-10"
				>
					<div class="lg:contents">
						<p class="text-[0.65rem] font-medium uppercase tracking-widest text-paper/60 lg:col-start-1 lg:row-start-1">
							Fly into
						</p>
						<p
							class="mt-2 font-display text-[5.5rem] font-light leading-none tracking-tight text-brass-light sm:text-[7rem] md:text-[8.5rem] lg:col-start-1 lg:row-start-2 lg:self-baseline"
						>
							TRV
						</p>
						<div class="mt-2 lg:col-start-1 lg:row-start-3">
							<p class="font-display text-xl font-light italic">Trivandrum International</p>
							<p class="mt-1 text-sm tabular-nums text-paper/60">8.48&deg; N, 76.92&deg; E</p>
						</div>
					</div>

					<!-- Route: vertical when stacked, horizontal across on large screens -->
					<div class="my-8 flex items-center gap-5 pl-[1.1rem] lg:hidden" aria-hidden="true">
						<div class="relative h-20 w-2">
							<span class="absolute left-0 top-0 size-2 rounded-full border border-brass-light"></span>
							<div class="absolute inset-y-2 left-1/2 border-l border-dashed border-brass-light/70"></div>
							<span class="absolute bottom-0 left-0 size-2 rounded-full bg-brass-light"></span>
						</div>
						<p class="text-[0.65rem] uppercase tracking-widest text-brass-light">By car &middot; about 30 min</p>
					</div>
					<div class="relative hidden self-center lg:col-start-2 lg:row-start-2 lg:block" aria-hidden="true">
						<p
							class="absolute inset-x-0 -top-7 text-center text-[0.65rem] uppercase tracking-widest text-brass-light"
						>
							By car &middot; about 30 min
						</p>
						<div class="relative h-10">
							<span
								class="absolute left-0 top-1/2 size-2 -translate-y-1/2 rounded-full border border-brass-light"
							></span>
							<div class="absolute inset-x-2 top-1/2 border-t border-dashed border-brass-light/70"></div>
							<span class="absolute right-0 top-1/2 size-2 -translate-y-1/2 rounded-full bg-brass-light"></span>
						</div>
					</div>

					<div class="lg:contents">
						<p
							class="text-[0.65rem] font-medium uppercase tracking-widest text-paper/60 lg:col-start-3 lg:row-start-1 lg:text-right"
						>
							Stay at
						</p>
						<p
							class="mt-2 font-display text-[5.5rem] font-light leading-none tracking-tight text-brass-light sm:text-[7rem] md:text-[8.5rem] lg:col-start-3 lg:row-start-2 lg:self-baseline lg:text-right"
						>
							<span class="mr-2 sm:mr-3 text-4xl text-paper sm:text-5xl">The</span>Leela
						</p>
						<div class="mt-2 lg:col-start-3 lg:row-start-3 lg:text-right">
							<p class="font-display text-xl font-light italic">Kovalam</p>
							<p class="mt-1 text-sm tabular-nums text-paper/60">8.40&deg; N, 76.98&deg; E</p>
						</div>
					</div>
				</div>

				<!-- Perforation, with notches cut from the page background -->
				<div class="relative border-t border-dashed border-paper/25" aria-hidden="true">
					<span class="absolute left-0 top-0 size-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-paper"></span>
					<span class="absolute right-0 top-0 size-6 translate-x-1/2 -translate-y-1/2 rounded-full bg-paper"></span>
				</div>

				<div class="flex flex-col gap-8 p-8 md:px-12 lg:flex-row lg:items-end lg:justify-between">
					<p class="text-sm">
						The wedding is at The Leela too &mdash;
						<a
							href="#hotel-block"
							class="underline decoration-paper/40 underline-offset-4 transition-colors hover:decoration-paper"
							>see the room block &darr;</a
						>
					</p>

					<ul class="flex flex-wrap gap-x-8 gap-y-3">
						{
							links.map((l) => (
								<li>
									<a
										href={l.href}
										target="_blank"
										rel="noopener noreferrer"
										class="text-sm text-brass-light underline decoration-brass-light/50 underline-offset-4 transition-colors hover:text-paper hover:decoration-paper"
									>
										{l.label} &nearr;
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- Two ways in: guests flying from abroad, and family coming from home -->
			<div class="mt-16 grid grid-cols-1 gap-14 md:mt-20 md:grid-cols-2 md:gap-10">
				{
					routes.map((r) => (
						<section>
							<h2 class="font-display text-4xl text-deep md:text-5xl">{r.title}</h2>
							<ul class="mt-8">
								{r.notes.map((n) => (
									<li class="border-t border-ink/15 py-6">
										<h3 class="font-display text-2xl text-deep">{n.heading}</h3>
										<p
											class:list={[
												'mt-3 text-lg leading-relaxed',
												n.body === TBD ? 'italic text-ink/50' : 'text-ink/80',
											]}
										>
											{n.body}
										</p>
									</li>
								))}
							</ul>
						</section>
					))
				}
			</div>

			<section id="hotel-block" class="mt-16 grid grid-cols-1 bg-paper-dim md:mt-20 md:grid-cols-12">
				<figure class="relative overflow-hidden md:order-last md:col-span-5">
					<!-- Zoomed toward the hotel (1.25x stacked, 1.5x beside the text); sizes is scaled to match so it stays sharp -->
					<Image
						src={kovalamPhoto}
						alt="The Leela's white, terraced buildings on a green headland above the bay at Kovalam, with rocks and palms in the foreground"
						widths={[720, 1200, 1800, 2400]}
						sizes="(min-width: 768px) 60vw, 125vw"
						class="aspect-square w-full origin-[30%_60%] scale-125 object-cover object-bottom md:absolute md:inset-0 md:aspect-auto md:h-full md:scale-150"
					/>
					<figcaption
						class="absolute inset-x-0 bottom-0 bg-linear-to-t from-deep-dark/70 to-transparent px-5 pb-4 pt-12 font-display text-base italic text-paper md:text-lg"
					>
						The Leela, on the headland at Kovalam
					</figcaption>
				</figure>

				<div class="p-6 md:col-span-7 md:p-10">
					<h2 class="font-display text-4xl text-deep md:text-5xl">The hotel block</h2>
					<p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-ink/80">
						We&rsquo;ve set aside rooms at The Leela at a group rate for guests travelling from the US and those
						we&rsquo;ve reached out to directly. Rooms not booked by the
						deadline go back to the hotel, so please book early.
					</p>
					<dl class="mt-8 grid grid-cols-1 gap-6 border-t border-ink/15 pt-6 text-sm sm:grid-cols-2">
						{
							block.map((b) => (
								<div>
									<dt class="text-[0.65rem] font-medium uppercase tracking-widest text-ink/50">{b.label}</dt>
									<dd class:list={['mt-1', b.value === TBD ? 'italic text-ink/50' : 'text-ink/85']}>{b.value}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<section class="mt-16 md:mt-20">
				<h2 class="font-display text-4xl text-deep md:text-5xl">Before you fly</h2>
				<ul class="mt-8">
					{
						checklist.map((c) => (
							<li class="grid grid-cols-1 gap-x-10 gap-y-2 border-t border-ink/15 py-6 md:grid-cols-[12rem_1fr]">
								<h3 class="font-display text-2xl text-deep">{c.item}</h3>
								<div>
									<p class="max-w-[60ch] text-lg leading-relaxed text-ink/80">{c.body}</p>
									{c.href && (
										<a
											href={c.href}
											target="_blank"
											rel="noopener noreferrer"
											class="mt-3 inline-block text-rose underline decoration-rose/40 underline-offset-4 transition-colors hover:decoration-rose"
										>
											{c.cta} &nearr;
										</a>
									)}
								</div>
							</li>
						))
					}
				</ul>
			</section>

			<section class="mt-16 grid grid-cols-1 gap-10 bg-deep p-8 text-paper md:mt-20 md:grid-cols-12 md:p-12">
				<div class="md:col-span-5">
					<h2 class="font-display text-4xl md:text-5xl">Monsoon season</h2>
				</div>
				<div class="md:col-span-7">
					<p class="max-w-[55ch] text-lg leading-relaxed text-paper/85">
						June is the height of the monsoon: warm, humid, and green, with heavy showers that tend to come and go. The
						sea at Kovalam is rough this time of year, so enjoy it from the shore and stick to the hotel pools for
						swimming.
					</p>
					<dl class="mt-8 grid grid-cols-1 gap-5 border-t border-paper/25 pt-6 text-sm sm:grid-cols-3">
						{
							weather.map((w) => (
								<div>
									<dt class="text-[0.65rem] uppercase tracking-widest text-paper/60">{w.label}</dt>
									<dd class="mt-1">{w.value}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<section class="mt-16 md:mt-20">
				<h2 class="font-display text-4xl text-deep md:text-5xl">Around Kovalam</h2>
				<ul class="mt-8 grid grid-cols-1 gap-x-10 md:grid-cols-2">
					{
						extras.map((e) => (
							<li class="border-t border-ink/15 py-8">
								<h3 class="font-display text-3xl text-deep">{e.place}</h3>
								<p class="mt-4 text-lg leading-relaxed text-ink/80">{e.body}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="mt-16 border-t border-ink/15 pt-10 md:mt-20">
				<h2 class="font-display text-3xl text-deep">Travel questions?</h2>
				<p class:list={['mt-3 text-lg leading-relaxed', contact === TBD ? 'italic text-ink/50' : 'text-ink/80']}>
					{contact}
				</p>
			</section>
		</div>
	</article>
</Page>
