---
import TempleMark from './TempleMark.astro'
---

<section id="rsvp" class="relative overflow-hidden bg-deep text-paper">
	<TempleMark
		class="pointer-events-none absolute -bottom-16 -left-16 h-80 w-80 text-deep-light opacity-40"
	/>
	<div class="relative mx-auto max-w-2xl px-6 py-24 text-center md:py-32">
		<h2 class="font-display text-4xl md:text-5xl">
			Invitations to follow
		</h2>
		<p class="mt-5 text-lg leading-relaxed text-paper/80">
			Once dates for both ceremonies are set, we&rsquo;ll send a text with a
			link to RSVP online for whichever celebration you&rsquo;re joining.
			Check back here for updates in the meantime.
		</p>
	</div>
</section>
