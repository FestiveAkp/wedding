---
import type { Section } from '../data/sections'

interface Props {
	next?: Section
}

const { next } = Astro.props
const target = next ?? { href: '/', no: '00', title: 'Back to the cover' }
---

<nav aria-label="Next page" class="mx-auto max-w-6xl px-6 md:px-10">
	<a
		href={target.href}
		class:list={[
			'group grid items-baseline gap-x-4 border-t border-ink/15 py-10 md:gap-x-8 md:py-14',
			next ? 'grid-cols-[3rem_1fr] md:grid-cols-[5rem_1fr]' : 'grid-cols-1',
		]}
	>
		{next && <span class="font-display text-3xl font-light italic text-brass md:text-5xl">{next.no}</span>}
		<span class="font-display text-3xl font-light text-deep transition-colors group-hover:text-rose md:text-5xl">
			{target.title}
			<span
				aria-hidden="true"
				class="relative top-[-0.1em] ml-3 inline-block text-2xl text-ink/40 transition-all group-hover:translate-x-2 group-hover:text-rose md:ml-5 md:text-4xl"
			>
				→
			</span>
		</span>
	</a>
</nav>
