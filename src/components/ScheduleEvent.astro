---
import type { WeddingEvent } from '../data/events'

interface Props {
	event: Omit<WeddingEvent, 'description'>
}

const { title, place, date, time } = Astro.props.event
---

<div class="grid grid-cols-1 gap-14 py-14 md:grid-cols-12 md:gap-10 md:py-20">
	<div class="md:col-span-4">
		{
			date ? (
				<>
					<p class="text-xs font-medium uppercase tracking-widest text-ink/50">{date.weekday}</p>
					<p class="font-display text-[9rem] font-light leading-[0.85] text-rose md:text-[11rem]">{date.day}</p>
					<p class="mt-2 font-display text-2xl italic text-deep">{date.month}</p>
				</>
			) : (
				<p class="font-display text-3xl font-light italic text-rose md:text-4xl">Date to be announced</p>
			)
		}
		<div class="mt-6 h-px w-16 bg-brass"></div>
		<p class="mt-4 text-sm text-ink/60">{time ?? 'Time to be announced'}</p>
	</div>

	<div class="md:col-span-8">
		<section>
			<h2 class="font-display text-4xl text-deep md:text-5xl">{title}</h2>
			<p class="mt-3 font-display text-xl italic text-ink/70">{place}</p>
			<div class="mt-6 max-w-[55ch] text-lg leading-relaxed text-ink/85">
				<slot />
			</div>
		</section>
		<slot name="aside" />
	</div>
</div>
