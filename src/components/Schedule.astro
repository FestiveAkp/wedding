---
const days = [
	{
		date: 'Sunday, June 27',
		events: [
			{ time: '10 AM', name: 'Thalikettu ceremony', place: 'Vilakanoor Bhuvaneshwari Temple', accent: 'brass' },
			{ time: 'To follow', name: 'Wedding ceremony', place: 'The Leela Kovalam', accent: 'rose' },
			{ time: 'To follow', name: 'Lunch', place: 'The Leela Kovalam', accent: 'rose' },
		],
	},
]

const accentBorder = (accent: string) => (accent === 'brass' ? 'border-brass' : 'border-rose')
---

<section id="schedule">
	<div class="mx-auto max-w-3xl px-6 py-24 md:px-10 md:py-32">
		<h2 class="font-display text-4xl text-deep md:text-5xl">Schedule</h2>
		<p class="mt-4 max-w-[55ch] text-lg text-ink/70">
			Times are tentative for now and may shift as plans come together.
		</p>

		<div class="mt-12 space-y-12">
			{
				days.map((day) => (
					<div>
						<h3 class="text-sm font-medium uppercase tracking-widest text-ink/60">{day.date}</h3>
						<ol class="mt-6 space-y-8">
							{day.events.map((event) => (
								<li class={`border-l-2 pl-4 ${accentBorder(event.accent)}`}>
									<p class="text-sm text-ink/50">{event.time}</p>
									<p class="mt-1 font-display text-xl text-deep">{event.name}</p>
									<p class="mt-1 text-ink/75">{event.place}</p>
								</li>
							))}
						</ol>
					</div>
				))
			}
		</div>
	</div>
</section>
