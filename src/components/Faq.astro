---
const faqs = [
	{
		q: 'Which ceremony should I attend?',
		a: 'Whichever one you’re invited to — see the guest notes under The ceremonies above. Broadly, Kerala is close family and relatives living in India, and Aurora is where we’re hoping to see family and friends from the U.S.',
	},
	{
		q: 'What should I wear?',
		a: 'Details on dress for each ceremony are still being finalized — we’ll add guidance here well ahead of the date.',
	},
	{
		q: 'Are children welcome?',
		a: 'Yes, at both ceremonies. We’ll note this again on formal invitations.',
	},
	{
		q: 'Is there a wedding registry?',
		a: 'No registry, and please don’t feel you need to bring anything — your being there is what matters to us. If you’d still like to give something, we’ll have a drop box for cash gifts at the Aurora wedding.',
	},
]
---

<section id="faq" class="bg-paper-dim">
	<div class="mx-auto max-w-3xl px-6 py-24 md:px-10 md:py-32">
		<h2 class="font-display text-4xl text-deep md:text-5xl">Questions</h2>

		<div class="mt-12 divide-y divide-deep/15 border-t border-t-deep/15">
			{
				faqs.map((item) => (
					<details class="group py-6">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl text-deep">
							{item.q}
							<span
								class="shrink-0 text-2xl leading-none text-brass transition-transform group-open:rotate-45"
								aria-hidden="true"
							>
								+
							</span>
						</summary>
						<p class="mt-4 max-w-[60ch] text-ink/75 leading-relaxed">
							{item.a}
						</p>
					</details>
				))
			}
		</div>
	</div>
</section>
