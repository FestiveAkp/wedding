---
import TempleMark from './TempleMark.astro'

const links = [
	{ href: '#story', label: 'Our story' },
	{ href: '#ceremonies', label: 'The ceremonies' },
	{ href: '#travel', label: 'Travel' },
	{ href: '#faq', label: 'FAQ' },
]
---

<section id="top" class="relative isolate min-h-svh overflow-hidden bg-deep-dark text-paper">
	{/*
		Photo placeholder — swap this whole block for a real <img>/<Image> of the two of you,
		e.g. import photo from '../assets/hero.jpg' and render it absolute inset-0 h-full w-full
		object-cover here. Keep the two gradient scrims below it so the corner text stays legible.
	*/}
	<div class="absolute inset-0 -z-20 bg-deep" />
	<div class="absolute inset-0 -z-10 bg-linear-to-br from-black/70 via-transparent to-transparent"></div>
	<div class="absolute inset-0 -z-10 bg-linear-to-tl from-black/70 via-transparent to-transparent"></div>

	<div class="pointer-events-none absolute inset-3 border border-paper/25 md:inset-6"></div>

	<div class="relative flex min-h-svh flex-col p-10 md:p-14">
		<div class="flex items-start justify-between gap-8">
			<div class="max-w-md">
				<p class="text-sm text-paper/80">The wedding of</p>
				<h1
					class="mt-1 font-display text-[clamp(2.75rem,8vw,5.5rem)] font-light leading-[0.95] text-paper"
				>
					Meghna <span class="font-normal italic text-brass-light">&amp;</span> Akash
				</h1>
			</div>

			<nav aria-label="Primary" class="hidden shrink-0 pt-2 text-right sm:block">
				<ul class="space-y-2.5 text-sm">
					{
						links.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-paper/80 decoration-brass-light decoration-2 underline-offset-4 hover:text-paper hover:underline"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div class="mt-auto self-end text-right">
			<p class="font-display text-2xl text-paper">June 2027</p>
			<p class="mt-2 text-paper/85">Kerala, India</p>
			<p class="text-paper/85">Aurora, Illinois</p>
		</div>
	</div>
</section>
