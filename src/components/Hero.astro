---
import { Image } from 'astro:assets'
import heroPhoto from '../assets/2B3A8729.jpg'
import TempleMark from './TempleMark.astro'

const links = [
	{ href: '#welcome', label: 'Welcome' },
	{ href: '#ceremonies', label: 'The ceremonies' },
	{ href: '#travel', label: 'Travel' },
	{ href: '#faq', label: 'FAQ' },
]
---

<section id="top" class="relative isolate min-h-svh overflow-hidden bg-deep-dark text-paper">
	<Image
		src={heroPhoto}
		alt="Meghna and Akash smiling at each other in front of Buckingham Fountain at dusk"
		widths={[640, 1280, 1920, 2560]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
		class="absolute inset-0 -z-20 h-full w-full object-cover object-[43%_center]"
	/>
	<div
		class="absolute inset-0 -z-10 bg-radial-[ellipse_at_43%_55%] from-transparent from-25% to-black/85 to-100%"
	></div>

	<div class="pointer-events-none absolute inset-3 border border-paper/25 md:inset-6"></div>

	<div class="relative flex min-h-svh flex-col p-10 md:p-14">
		<div class="flex items-start justify-between gap-8">
			<div class="max-w-md md:max-w-2xl">
				<p class="text-sm uppercase tracking-widest text-paper/80 md:text-lg">The wedding of</p>
				<h1
					class="mt-1 font-display text-[clamp(2.75rem,8vw,5.5rem)] font-light leading-[0.95] text-paper md:text-[clamp(4.75rem,9.5vw,8rem)]"
				>
					Meghna <span class="font-normal italic text-brass-light">&amp;</span> Akash
				</h1>
			</div>

			<nav aria-label="Primary" class="hidden shrink-0 text-right sm:block">
				<ul class="space-y-3 md:space-y-4">
					{
						links.map((link, i) => (
							<li class="flex items-center justify-end gap-3">
								<a
									href={link.href}
									class="text-xs font-medium uppercase tracking-[0.2em] text-paper/80 hover:text-paper md:text-sm"
								>
									{link.label}
								</a>
								<span class="font-display text-xs italic text-brass-light md:text-sm">
									{String(i + 1).padStart(2, '0')}
								</span>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div class="mt-auto flex flex-col items-end self-end text-right">
			<p class="font-display text-2xl text-paper md:text-4xl">June 27, 2027</p>
			<div class="my-2.5 h-px w-12 bg-brass-light md:w-16"></div>
			<p class="text-xs font-medium uppercase tracking-[0.2em] text-paper/80 md:text-sm">Kerala, India</p>
		</div>
	</div>
</section>
