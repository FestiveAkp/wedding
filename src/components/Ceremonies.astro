---
import CeremonySpread from './CeremonySpread.astro'
---

<section id="ceremonies" class="bg-paper-dim">
	<div class="mx-auto max-w-6xl px-6 py-24 md:px-10 md:py-32">
		<h2 class="max-w-xl font-display text-4xl text-deep md:text-5xl">
			The ceremonies
		</h2>
		<div class="mt-14 space-y-24">
			<CeremonySpread
				kicker="Venganoor"
				title="Thalikettu"
				venue="Vilakanoor Bhuvaneshwari Temple"
				location="Venganoor, Thiruvananthapuram"
				description="A traditional, intimate ceremony at the temple where the thali is tied to begin our married life together."
				dateNote="Sunday, June 27, 2027"
				guestNote="Close family and relatives"
				accent="brass"
			/>
			<CeremonySpread
				kicker="Kovalam"
				title="Wedding"
				venue="The Leela Kovalam"
				location="Kovalam, Thiruvananthapuram"
				description="After the temple, we'll head to The Leela for our wedding ceremony, followed by lunch."
				dateNote="Sunday, June 27, 2027"
				guestNote="Family and friends"
				accent="rose"
				reverse
			/>
		</div>
	</div>
</section>
