---
import CeremonySpread from './CeremonySpread.astro'
---

<section id="ceremonies" class="bg-paper-dim">
	<div class="mx-auto max-w-6xl px-6 py-24 md:px-10 md:py-32">
		<h2 class="max-w-xl font-display text-4xl text-deep md:text-5xl">
			The ceremonies
		</h2>
		<div class="mt-14 space-y-24">
			<CeremonySpread
				kicker="Kerala, India"
				title="Thalikettu"
				venue="A family temple in Kerala"
				location="Exact temple to be shared closer to the date"
				description="A traditional, intimate ceremony at Meghna's family temple, tying the thali to begin our married life together, followed by a sadya — a traditional Kerala vegetarian feast served on a banana leaf."
				dateNote="To be announced, June 2027"
				guestNote="Close family and relatives living in India"
				accent="brass"
			/>
			<CeremonySpread
				kicker="Aurora, Illinois"
				title="Wedding"
				venue="Sri Venkateswara Swami (Balaji) Temple"
				location="Aurora, Illinois"
				description="Our wedding ceremony, followed by an Indian lunch with both vegetarian and non-vegetarian dishes, for family and friends joining us from around the U.S."
				dateNote="To be announced, June 2027"
				guestNote="Family and friends from the U.S."
				accent="rose"
				reverse
			/>
		</div>
	</div>
</section>
