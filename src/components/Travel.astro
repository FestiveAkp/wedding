---
const places = [
	{
		place: 'Flying in',
		border: 'border-brass',
		body: 'The Leela Kovalam is just south of Thiruvananthapuram, so Trivandrum International Airport is the closest to fly into.',
	},
	{
		place: 'Getting around',
		border: 'border-rose',
		body: 'Kovalam is a short drive from the airport, and taxis and app-based cabs are easy to find around Thiruvananthapuram.',
	},
]
---

<section id="travel" class="bg-paper">
	<div class="mx-auto max-w-6xl px-6 py-24 md:px-10 md:py-32">
		<h2 class="font-display text-4xl text-deep md:text-5xl">Getting there</h2>

		<div class="mt-14 grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-16">
			{
				places.map((p) => (
					<div class={`border-t-2 pt-6 ${p.border}`}>
						<h3 class={`font-display text-2xl text-deep`}>{p.place}</h3>
						<p class="mt-3 text-ink/75 leading-relaxed">{p.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
